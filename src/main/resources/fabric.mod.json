{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"AirmailSoap3209"
	],
	"contact": {
		"homepage": "https://github.com/AirmailSoap3209/trevorplus",
		"sources": "https://github.com/AirmailSoap3209/trevorplus",
		"issues": "https://github.com/AirmailSoap3209/trevorplus/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/trevorplus/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.trevorplus.Trevorplus"
		],
		"client": [
			"com.trevorplus.client.TrevorplusClient"
		],
		"modmenu": [
			"com.trevorplus.client.ModMenuEntry"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"breaks": {
		"${other_id}": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"trevorplus": {
			"curseforgeId": "${curseforge_id}",
			"curseforgeSlug": "${curseforge_slug}",
			"modrinthId": "${modrinth_id}"
		},
		"modmenu": {
			"badges": [
				"client"
			]
		}
	}
}
